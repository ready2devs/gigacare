{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GigaCare",
  "version": "1.0.0",
  "identifier": "app.gigacare.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "GigaCare",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "decorations": true,
        "transparent": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  }
}